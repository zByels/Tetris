import pygame
import random
import json
import os

# Definindo as constantes de configuração do jogo
LARGURA_JOGO = 300
ALTURA_JOGO = 600
TAMANHO_CELULA = 30
LINHAS = ALTURA_JOGO // TAMANHO_CELULA
COLUNAS = LARGURA_JOGO // TAMANHO_CELULA

# Cores
Cores = {
    'I': (0, 255, 255),
    'T': (128, 0, 128),
    'O': (255, 255, 255),
    'S': (0, 255, 0),
    'Z': (255, 0, 0),
    'L': (255, 165, 0),
    'J': (0, 0, 255),
    'F': (0, 0, 0)
}

# Formas dos Tetrominos
formas = [
    [[1, 1, 1, 1]],  # I
    [[1, 1, 1], [0, 1, 0]],  # T
    [[1, 1], [1, 1]],  # O
    [[0, 1, 1], [1, 1, 0]],  # S
    [[1, 1, 0], [0, 1, 1]],  # Z
    [[1, 1, 1], [1, 0, 0]],  # L
    [[1, 1, 1], [0, 0, 1]]   # J
]

class Forma:
    def __init__(self, forma, cor):
        self.forma = forma
        self.cor = cor
        self.x = COLUNAS // 2 - len(forma[0]) // 2
        self.y = 0

    def rotacionar(self):
        self.forma = [list(row) for row in zip(*self.forma[::-1])]

class Tetromino(Forma):
    def __init__(self):
        forma_idx = random.randint(0, len(formas) - 1)
        forma = formas[forma_idx]
        cor = Cores[list(Cores.keys())[forma_idx]]
        super().__init__(forma, cor)

class Grade:
    def __init__(self):
        self.grade = [[0 for _ in range(COLUNAS)] for _ in range(LINHAS)]

    def adicionar_tetromino(self, tetromino):
        for i, linha in enumerate(tetromino.forma):
            for j, valor in enumerate(linha):
                if valor:
                    self.grade[tetromino.y + i][tetromino.x + j] = tetromino.cor

    def desenhar(self, tela):
        for i in range(LINHAS):
            for j in range(COLUNAS):
                if self.grade[i][j]:
                    pygame.draw.rect(tela, self.grade[i][j],
                                     (j * TAMANHO_CELULA, i * TAMANHO_CELULA, TAMANHO_CELULA, TAMANHO_CELULA))

    def verificar_colisao(self, tetromino):
        for i, linha in enumerate(tetromino.forma):
            for j, valor in enumerate(linha):
                if valor:
                    if (tetromino.y + i >= LINHAS) or (tetromino.x + j < 0) or (tetromino.x + j >= COLUNAS) or (self.grade[tetromino.y + i][tetromino.x + j]):
                        return True
        return False

    def remover_linhas_completas(self):
        linhas_removidas = 0
        for i in range(LINHAS - 1, -1, -1):
            if all(self.grade[i]):
                del self.grade[i]
                self.grade.insert(0, [0 for _ in range(COLUNAS)])
                linhas_removidas += 1
        return linhas_removidas

class Jogo:
    def __init__(self):
        pygame.init()
        self.tela = pygame.display.set_mode((LARGURA_JOGO, ALTURA_JOGO))
        pygame.display.set_caption("Tetris")
        self.clock = pygame.time.Clock()
        self.grade = Grade()
        self.tetromino = Tetromino()
        self.ponto = 0
        self.linhas_removidas = 0
        self.velocidade = 5  # Velocidade inicial

    def rodar(self):
        while True:
            for evento in pygame.event.get():
                if evento.type == pygame.QUIT:
                    pygame.quit()
                    exit()

                if evento.type == pygame.KEYDOWN:
                    if evento.key == pygame.K_LEFT:
                        self.tetromino.x -= 1
                        if self.grade.verificar_colisao(self.tetromino):
                            self.tetromino.x += 1
                    elif evento.key == pygame.K_RIGHT:
                        self.tetromino.x += 1
                        if self.grade.verificar_colisao(self.tetromino):
                            self.tetromino.x -= 1
                    elif evento.key == pygame.K_DOWN:
                        self.tetromino.y += 1
                        if self.grade.verificar_colisao(self.tetromino):
                            self.tetromino.y -= 1
                    elif evento.key == pygame.K_UP:
                        self.tetromino.rotacionar()
                        if self.grade.verificar_colisao(self.tetromino):
                            self.tetromino.rotacionar()  # Reverte a rotação

            # Queda automática do tetromino
            self.tetromino.y += 1
            if self.grade.verificar_colisao(self.tetromino):
                self.tetromino.y -= 1
                self.grade.adicionar_tetromino(self.tetromino)
                linhas_removidas = self.grade.remover_linhas_completas()
                self.ponto += 2 * linhas_removidas
                self.linhas_removidas += linhas_removidas
                
                # Aumenta a velocidade a cada 3 linhas removidas
                if self.linhas_removidas >= 3:
                    self.velocidade += 1
                    self.linhas_removidas = 0  # Reseta o contador

                self.tetromino = Tetromino()
                if self.grade.verificar_colisao(self.tetromino):
                    print("Game Over")
                    pygame.quit()
                    exit()

            self.tela.fill((0, 0, 0))  # Limpa a tela
            self.grade.desenhar(self.tela)

            for i, linha in enumerate(self.tetromino.forma):
                for j, valor in enumerate(linha):
                    if valor:
                        pygame.draw.rect(self.tela, self.tetromino.cor,
                                         ((self.tetromino.x + j) * TAMANHO_CELULA, (self.tetromino.y + i) * TAMANHO_CELULA, TAMANHO_CELULA, TAMANHO_CELULA))

            pygame.display.flip()
            self.clock.tick(10 + self.velocidade)  # Aumenta a taxa de atualização com base na velocidade

# Inicializa e executa o jogo
if __name__ == "__main__":
    jogo = Jogo()
    jogo.rodar()
